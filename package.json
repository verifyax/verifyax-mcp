{
  "name": "verifyax-mcp-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the VerifyAX SDK and MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.15",
      "fast-uri": "3.1.6",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "qs": "6.16.0",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "postcss@<=8.5.22": ">=8.5.23",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "hono@<4.13.5": ">=4.13.5"
    }
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "gen:types": "openapi-typescript packages/sdk/openapi/verifyax.yaml -o packages/sdk/src/types.gen.ts",
    "gen:spec-meta": "node scripts/gen-spec-meta.mjs",
    "sync:spec": "bash scripts/sync-sdk-spec.sh",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "check:versions": "node scripts/check-versions.mjs",
    "test:integration": "pnpm --filter @verifyax/sdk test:integration",
    "test:conformance": "pnpm --filter @verifyax/mcp-server test:conformance",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
